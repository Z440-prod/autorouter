+#[derive(Debug)]
+enum ClassifierFailure {
+    Provider(CodexErr),
+    Malformed(String),
+}
+
+impl From<String> for ClassifierFailure {
+    fn from(error: String) -> Self {
+        Self::Malformed(error)
+    }
+}
+
+impl ClassifierFailure {
+    fn summary(&self) -> &'static str {
+        match self {
+            Self::Malformed(_) => "invalid classifier response",
+            Self::Provider(error) => match error.details() {
+                CodexErrorDetails::InvalidPrompt { .. } | CodexErrorDetails::InvalidRequest(_) => {
+                    "provider rejected the classifier prompt"
+                }
+                CodexErrorDetails::ContentPolicyViolation { .. }
+                | CodexErrorDetails::ContentFilter
+                | CodexErrorDetails::InferenceHookDenied { .. }
+                | CodexErrorDetails::CyberPolicy { .. }
+                | CodexErrorDetails::BioPolicy { .. }
+                | CodexErrorDetails::MisalignmentPolicyViolation { .. } => {
+                    "provider blocked the classifier request"
+                }
+                _ => "classifier provider unavailable",
+            },
+        }
+    }
+
+    fn retryable(&self) -> bool {
+        // The native client already retries transient transport errors. Replaying policy errors is unsafe.
+        matches!(self, Self::Malformed(_))
+    }
+}
