+pub(crate) async fn select_child(
+    sess: &Session,
+    turn: &TurnContext,
+    task: &str,
+) -> Option<(String, ReasoningEffort)> {
+    if !enabled()
+        || task.trim().is_empty()
+        || crate::guardian::is_basic_session_source(&turn.session_source)
+    {
+        return None;
+    }
+    let manager = &sess.services.models_manager;
+    let catalog = tokio::time::timeout(
+        std::time::Duration::from_secs(4),
+        manager.model_catalog_with_origins(
+            RefreshStrategy::OnlineIfUncached,
+            turn.config.http_client_factory(),
+        ),
+    )
+    .await
+    .ok()?;
+    let models = eligible_models(sess, catalog);
+    let verified = verified_defaults(turn).await;
+    let dispatcher = classifier(&models, &verified)?;
+    let candidates = models
+        .iter()
+        .filter(|model| {
+            crate::agent::child_config::model_supports_multi_agent_backend(
+                model,
+                turn.multi_agent_version,
+            )
+        })
+        .cloned()
+        .collect::<Vec<_>>();
+    let decision = match tokio::time::timeout(
+        std::time::Duration::from_secs(15),
+        classify(sess, turn, dispatcher, &candidates, &verified, Some(task)),
+    )
+    .await
+    {
+        Ok(Ok(decision)) => decision,
+        Ok(Err(error)) => {
+            tracing::info!(target: "autorouter", reason = error.summary(), "using inherited child settings");
+            return None;
+        }
+        Err(_) => return None,
+    };
+    let model = candidates
+        .iter()
+        .find(|candidate| candidate.model == decision.model)?;
+    let effort = effort(model, &decision.tier).ok()?;
+    let catalog = manager
+        .model_catalog_with_origins(RefreshStrategy::InMemory, turn.config.http_client_factory())
+        .await;
+    if !eligible_models(sess, catalog).iter().any(|entry| {
+        entry.model == decision.model
+            && entry
+                .supported_reasoning_efforts
+                .iter()
+                .any(|preset| preset.effort == effort)
+            && crate::agent::child_config::model_supports_multi_agent_backend(
+                entry,
+                turn.multi_agent_version,
+            )
+    }) {
+        return None;
+    }
+    tracing::info!(target: "autorouter", model = %decision.model, %effort, "classified independent child task");
+    Some((decision.model, effort))
+}
