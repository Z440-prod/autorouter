+fn oscillates(history: &[(String, String)], next: &str, stage: &str) -> bool {
+    let [.., (earlier, earlier_stage), (latest, latest_stage)] = history else {
+        return false;
+    };
+    earlier == next
+        && latest != next
+        && earlier_stage == stage
+        && latest_stage == stage
+        && stage != "debugging"
+}
