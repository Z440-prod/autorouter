+// Preserve both streams before applying the in-memory head/tail budget.
+struct StreamArchive {
+    directory: std::path::PathBuf,
+    stdout: std::fs::File,
+    stderr: std::fs::File,
+    remaining: usize,
+    incomplete: bool,
+}
+
+impl StreamArchive {
+    fn open(path: &std::path::Path) -> std::io::Result<Self> {
+        let directory = tempfile::Builder::new()
+            .prefix("process-")
+            .tempdir_in(path)?;
+        let stdout = std::fs::File::create_new(directory.path().join("stdout.log"))?;
+        let stderr = std::fs::File::create_new(directory.path().join("stderr.log"))?;
+        Ok(Self {
+            directory: directory.keep(),
+            stdout,
+            stderr,
+            remaining: 64 * 1024 * 1024,
+            incomplete: false,
+        })
+    }
+
+    fn write(&mut self, stream: ExecOutputStream, chunk: &[u8]) {
+        use std::io::Write;
+        let bytes = self.remaining.min(chunk.len());
+        if bytes != chunk.len() {
+            self.mark_incomplete();
+        }
+        let output = if stream == ExecOutputStream::Stderr {
+            &mut self.stderr
+        } else {
+            &mut self.stdout
+        };
+        if output.write_all(&chunk[..bytes]).is_err() {
+            self.mark_incomplete();
+            self.remaining = 0;
+        } else {
+            self.remaining -= bytes;
+        }
+    }
+
+    fn mark_incomplete(&mut self) {
+        if !self.incomplete {
+            self.incomplete = true;
+            let _ = std::fs::File::create_new(self.directory.join("incomplete"));
+        }
+    }
+}
+
+impl Drop for StreamArchive {
+    fn drop(&mut self) {
+        if self.stdout.sync_all().is_err() || self.stderr.sync_all().is_err() {
+            self.mark_incomplete();
+        }
+    }
+}
