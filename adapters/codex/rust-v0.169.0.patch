+pub(super) async fn route(
+    sess: &Arc<Session>,
+    turn: &Arc<TurnContext>,
+    cancel: &CancellationToken,
+) -> CodexResult<()> {
+    if crate::guardian::is_basic_session_source(&turn.session_source) {
+        return Ok(());
+    }
+    let user_thread = sess
+        .state
+        .lock()
+        .await
+        .session_configuration
+        .thread_source
+        .as_ref()
+        .is_none_or(|source| matches!(source, codex_protocol::protocol::ThreadSource::User));
+    if !user_thread {
+        return Ok(());
+    }
+    let (model_pin, effort_pin) = pins(sess);
+    if model_pin && effort_pin {
+        let current = turn.next_step_settings.load_full();
+        status(
+            sess,
+            turn,
+            format!(
+                "AutoRouter Manual | {} | {} | Memory: MCP",
+                current.model_info.slug,
+                current
+                    .effective_reasoning_effort()
+                    .map(|e| e.to_string())
+                    .unwrap_or_default()
+            ),
+        )
+        .await;
+        return Ok(());
+    }
+    let state = turn.extension_data.get_or_init(RoutingState::default);
+    if state.failed.load(Ordering::Relaxed) {
+        return Ok(());
+    }
+    status(
+        sess,
+        turn,
+        format!(
+            "AutoRouter ON | Luna classifying | current {} | Memory: MCP",
+            turn.capture_current_model_info().slug
+        ),
+    )
+    .await;
+    let start = Instant::now();
+    let manager = &sess.services.models_manager;
+    let catalog = manager
+        .model_catalog_with_origins(RefreshStrategy::InMemory, turn.config.http_client_factory())
+        .await;
+    observe_catalog(sess, &catalog);
+    let models = eligible_models(sess, catalog);
+    let verified = verified_defaults(turn).await;
+    let Some(dispatcher) = classifier(&models, &verified) else {
+        status(
+            sess,
+            turn,
+            "Model discovery pending or unavailable | retaining native model".into(),
+        )
+        .await;
+        return Ok(());
+    };
+    let classification = async {
+        match classify(sess, turn, dispatcher, &models, &verified, None).await {
+            Err(error) if error.retryable() => {
+                classify(sess, turn, dispatcher, &models, &verified, None).await
+            }
+            result => result,
+        }
+    }
+    .or_cancel(cancel);
+    let decision = match tokio::time::timeout(std::time::Duration::from_secs(30), classification)
+        .await
+    {
+        Ok(Ok(Ok(value))) => value,
+        Ok(Err(error)) => return Err(error.into()),
+        failure => {
+            let reason = match failure {
+                Ok(Ok(Err(ref error))) => {
+                    if let ClassifierFailure::Malformed(detail) = error {
+                        tracing::debug!(target: "autorouter", detail, "classifier response validation failed");
+                    }
+                    error.summary()
+                }
+                Err(_) => "classifier timed out",
+                _ => unreachable!("successful and cancelled classification handled above"),
+            };
+            state.failed.store(true, Ordering::Relaxed);
+            status(
+                sess,
+                turn,
+                format!(
+                    "AutoRouter degraded | retaining {} | {reason}",
+                    turn.capture_current_model_info().slug
+                ),
+            )
+            .await;
+            return Ok(());
+        }
+    };
+    // Serialize with native manual settings updates, then recheck pins after inference.
+    let _settings_guard = super::thread_settings::acquire_persistence_lock(sess)
+        .or_cancel(cancel)
+        .await?;
+    let (model_pin, effort_pin) = pins(sess);
+    let Some(model) = models.iter().find(|m| m.model == decision.model) else {
+        status(
+            sess,
+            turn,
+            "AutoRouter degraded | Luna selected an unavailable model; retaining current settings"
+                .into(),
+        )
+        .await;
+        return Ok(());
+    };
+    let selected_effort = match effort(model, &decision.tier) {
+        Ok(value) => value,
+        Err(error) => {
+            status(sess, turn, format!("AutoRouter degraded | {error}")).await;
+            return Ok(());
+        }
+    };
+    let current = turn.next_step_settings.load_full();
+    let destination = if model_pin {
+        current.model_info.slug.clone()
+    } else {
+        model.model.clone()
+    };
+    if oscillates(
+        &state.history.lock().expect("routing history"),
+        &destination,
+        &decision.stage,
+    ) {
+        status(
+            sess,
+            turn,
+            format!(
+                "AutoRouter ON | retaining {} | avoiding routing oscillation",
+                current.model_info.slug
+            ),
+        )
+        .await;
+        return Ok(());
+    }
+    let catalog_now = manager
+        .model_catalog_with_origins(RefreshStrategy::InMemory, turn.config.http_client_factory())
+        .await;
+    if !model_pin
+        && !catalog_now.iter().any(|entry| {
+            entry.origin == ModelOrigin::Provider
+                && entry.slug == destination
+                && entry.visibility == codex_protocol::openai_models::ModelVisibility::List
+        })
+    {
+        status(
+            sess,
+            turn,
+            "Model catalog changed during classification | retaining current settings".into(),
+        )
+        .await;
+        return Ok(());
+    }
+    let target = models.iter().find(|m| m.model == destination);
+    let selected_effort = if model_pin {
+        target.and_then(|m| effort(m, &decision.tier).ok())
+    } else {
+        Some(selected_effort)
+    };
+    let update = TurnSettingsUpdate {
+        model: (!model_pin).then_some(destination.clone()),
+        effort: selected_effort.filter(|_| !effort_pin).map(Some),
+        ..Default::default()
+    };
+    match sess.apply_turn_settings(&turn.sub_id, update).await {
+        TurnSettingsUpdateOutcome::Applied => {
+            let switched = (current.model_info.slug != destination)
+                .then(|| format!("{} -> ", current.model_info.slug))
+                .unwrap_or_default();
+            state
+                .history
+                .lock()
+                .expect("routing history")
+                .push((destination, decision.stage.clone()));
+
+            let selected = turn.next_step_settings.load_full();
+            let effective = selected
+                .effective_reasoning_effort()
+                .map(|e| e.to_string())
+                .unwrap_or_default();
+            let mode = if model_pin || effort_pin {
+                "Manual override"
+            } else {
+                "ON"
+            };
+            let code_mode = match crate::tools::effective_tool_mode(turn, &selected.model_info) {
+                ToolMode::CodeMode | ToolMode::CodeModeOnly => "ON",
+                _ => "OFF",
+            };
+            let workflows = apply_workflow(sess, turn, &selected.model_info, &decision).await;
+            let workflow = if workflows.is_empty() {
+                String::new()
+            } else {
+                format!(" | Workflow {}", workflows.join(", "))
+            };
+            status(
+                sess,
+                turn,
+                json!({
+                    "model": selected.model_info.slug,
+                    "effort": selected.effective_reasoning_effort(),
+                    "status": format!("AutoRouter {mode} | {switched}{} | {} ({effective}) | {} | Code Mode {code_mode}{workflow}",
+                        selected.model_info.slug, decision.tier, decision.stage)
+                }).to_string(),
+            )
+            .await;
+            tracing::info!(target: "autorouter", thread = %sess.thread_id(), turn = %turn.sub_id,
+                model = %selected.model_info.slug, effort = %effective, classifier = %dispatcher.model,
+                classification_ms = start.elapsed().as_millis(), skills = ?workflows,
+                knowledge = decision.knowledge, independent_review = decision.independent_review,
+                "routing applied at tool boundary");
+        }
+        outcome => {
+            status(
+                sess,
+                turn,
+                format!(
+                    "AutoRouter | switch rejected: {outcome:?}; retaining {}",
+                    current.model_info.slug
+                ),
+            )
+            .await
+        }
+    }
+    Ok(())
+}
+
+fn routing_record(item: &ResponseItem, limit: usize) -> Option<serde_json::Value> {
+    let bounded = |text: &str| text.chars().take(limit).collect::<String>();
+    let record = match item {
+        ResponseItem::Message { role, content, .. } if role == "user" || role == "assistant" => {
+            let text = content
+                .iter()
+                .filter_map(|item| match item {
+                    ContentItem::InputText { text } | ContentItem::OutputText { text, .. } => {
+                        Some(text.as_str())
+                    }
+                    _ => None,
+                })
+                .flat_map(|part| part.chars().chain(std::iter::once('\n')))
+                .take(limit)
+                .collect::<String>();
+            json!({"role": role, "text": text})
+        }
+        ResponseItem::AgentMessage { content, .. } => {
+            json!({"agent_message": bounded(&plaintext_agent_message_content(content)?)})
+        }
+        ResponseItem::FunctionCall {
+            name, arguments, ..
+        }
+        | ResponseItem::CustomToolCall {
+            name,
+            input: arguments,
+            ..
+        } => {
+            json!({"tool": name, "input": bounded(arguments)})
+        }
+        ResponseItem::FunctionCallOutput { output, .. }
+        | ResponseItem::CustomToolCallOutput { output, .. } => {
+            let text = output
+                .text_content()
+                .map(bounded)
+                .or_else(|| output.body.to_text().map(|value| bounded(&value)));
+            json!({"tool_output": text, "success": output.success})
+        }
+        _ => return None,
+    };
+    Some(record)
+}
+
+async fn classify(
+    sess: &Session,
+    turn: &TurnContext,
+    luna: &ModelPreset,
+    models: &[ModelPreset],
+    verified: &BTreeMap<String, String>,
+    child_task: Option<&str>,
+) -> Result<Decision, ClassifierFailure> {
+    let history = sess.clone_history().await;
+    let original = history
+        .raw_items()
+        .rfind(|item| matches!(item, ResponseItem::Message { role, .. } if role == "user"))
+        .and_then(|item| routing_record(item, 12_000));
+    let recent = history
+        .raw_items()
+        .rev()
+        .filter_map(|item| routing_record(item, 1_500))
+        .take(8)
+        .collect::<Vec<_>>();
+    let visual = child_task.is_none()
+        && history.raw_items().any(|item| match item {
+            ResponseItem::Message { content, .. } => content
+                .iter()
+                .any(|item| matches!(item, ContentItem::InputImage { .. })),
+            ResponseItem::FunctionCallOutput { output, .. }
+            | ResponseItem::CustomToolCallOutput { output, .. } => {
+                output.content_items().is_some_and(|items| {
+                    items.iter().any(|item| {
+                        matches!(item, FunctionCallOutputContentItem::InputImage { .. })
+                    })
+                })
+            }
+            _ => false,
+        });
+    let available: Vec<_> = models
+        .iter()
+        .filter(|m| !visual || m.input_modalities.contains(&InputModality::Image))
+        .collect();
+    let profiles = available.iter().map(|model| json!({
+        "id": model.model,
+        "family": family_version(&model.model).map(|(family, _)| family),
+        "description": model.description,
+        "default": model.is_default,
+        "evaluated_family_default": verified.values().any(|id| id == &model.model),
+        "efforts": model.supported_reasoning_efforts.iter().map(|preset| &preset.effort).collect::<Vec<_>>(),
+        "input_modalities": model.input_modalities,
+    })).collect::<Vec<_>>();
+    let skill_ids = if child_task.is_some() {
+        Vec::new()
+    } else {
+        workflow_skills(turn)
+            .into_iter()
+            .map(|skill| skill.name)
+            .collect::<Vec<_>>()
+    };
+    let request = if let Some(task) = child_task {
+        json!({"available": profiles, "subagent_task": task.chars().take(12_000).collect::<String>(),
+            "parent_user_request": original})
+    } else {
+        let recommendations = std::env::var("AUTOROUTER_RECOMMENDATIONS")
+            .ok()
+            .filter(|value| value.len() < 1024)
+            .and_then(|value| serde_json::from_str::<Vec<String>>(&value).ok())
+            .unwrap_or_default();
+        json!({"available": profiles, "original_request": original,
+            "recent_history_newest_first": recent, "visual": visual,
+            "available_workflow_skills": skill_ids,
+            "task_recommendations": recommendations,
+            "tools": "Native permissions and tools, Code Mode, scoped Graphify and Obsidian knowledge_search, CLI-Anything, and REA. Use only when relevant."})
+    };
+
+    let ids: Vec<_> = available.iter().map(|m| &m.model).collect();
+    if ids.is_empty() {
+        return Err(String::from("No catalog model supports the required input modalities").into());
+    }
+    let prompt = Prompt {
+        input: vec![ResponseItem::Message {
+            id: None,
+            role: "user".into(),
+            content: vec![ContentItem::InputText {
+                text: request.to_string(),
+            }],
+            encrypted_content: None,
+            status: None,
+            phase: None,
+            internal_chat_message_metadata_passthrough: None,
+        }],
+        base_instructions: BaseInstructions {
+            text: INSTRUCTIONS.into(),
+            provenance: None,
+        },
+        output_schema: Some(json!({"type":"object","additionalProperties":false,
+            "required":["model","tier","stage","reason","skills","knowledge","independent_review"],"properties":{
+                "model":{"type":"string","enum":ids},
+                "tier":{"type":"string","enum":["Low","Standard","Deep","Expert","Ultra"]},
+                "stage":{"type":"string","enum":["analysis","implementation","debugging","verification","completion"]},
+                "reason":{"type":"string"},
+                "skills":{"type":"array","items":{"type":"string"}},
+                "knowledge":{"type":"boolean"},
+                "independent_review":{"type":"boolean"}}})),
+        ..Default::default()
+    };
+    let info = sess
+        .services
+        .models_manager
+        .get_model_info(&luna.model, &turn.config.to_models_manager_config())
+        .await;
+    let metadata = crate::responses_metadata::CodexResponsesMetadata::new(
+        sess.installation_id.clone(),
+        sess.session_id().to_string(),
+        sess.thread_id().to_string(),
+        sess.current_window_id().await.to_string(),
+    );
+    let mut client = sess.services.model_client.new_session();
+    let mut stream = client
+        .stream(
+            &prompt,
+            &info,
+            &turn.session_telemetry,
+            Some(effort(luna, "Low")?),
+            info.default_reasoning_summary,
+            None,
+            &metadata,
+            &InferenceTraceContext::disabled(),
+        )
+        .await
+        .map_err(ClassifierFailure::Provider)?;
+    let mut output = String::new();
+    let mut deltas = String::new();
+    while let Some(event) = stream.next().await {
+        match event.map_err(ClassifierFailure::Provider)? {
+            ResponseEvent::OutputTextDelta(delta) => deltas.push_str(&delta),
+            ResponseEvent::OutputItemDone(item) => {
+                if let Some(text) =
+                    crate::stream_events_utils::raw_assistant_output_text_from_item(&item)
+                {
+                    output.push_str(&text);
+                }
+            }
+            ResponseEvent::Completed { .. } => {
+                let mut decision = parse_decision(if output.trim().is_empty() {
+                    &deltas
+                } else {
+                    &output
+                })?;
+                if !ids.iter().any(|id| **id == decision.model) {
+                    return Err(String::from(
+                        "Classifier selected a model outside the eligible catalog",
+                    )
+                    .into());
+                }
+                decision.skills.retain(|name| skill_ids.contains(name));
+                decision.skills.truncate(2);
+                return Ok(decision);
+            }
+            _ => {}
+        }
+    }
+    Err(String::from("Classifier stream ended without completion").into())
+}
+
+fn parse_decision(output: &str) -> Result<Decision, String> {
+    if output.trim().is_empty() {
+        return Err("Classifier returned empty text".into());
+    }
+    let d: Decision =
+        serde_json::from_str(output).map_err(|e| format!("Invalid classifier JSON: {e}"))?;
+    if d.model.trim().is_empty()
+        || !["Low", "Standard", "Deep", "Expert", "Ultra"].contains(&d.tier.as_str())
+        || ![
+            "analysis",
+            "implementation",
+            "debugging",
+            "verification",
+            "completion",
+        ]
+        .contains(&d.stage.as_str())
+        || d.reason.trim().is_empty()
+        || d.skills.len() > 8
+    {
+        return Err("Classifier decision violates routing schema".into());
+    }
+    Ok(d)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn rejected_classifier_prompt_degrades_without_retry_or_raw_provider_error() {
+        let failure = ClassifierFailure::Provider(
+            CodexErrorDetails::InvalidPrompt {
+                message: "Invalid prompt: provider-detail".into(),
+            }
+            .into(),
+        );
+        assert!(!failure.retryable());
+        assert_eq!(failure.summary(), "provider rejected the classifier prompt");
+        let nested = ClassifierFailure::Provider(
+            CodexErrorDetails::ModelNotFound {
+                message: "Err(Provider(unknown-model))".into(),
+                status: None,
+            }
+            .into(),
+        );
+        assert!(!nested.retryable());
+        assert_eq!(nested.summary(), "classifier provider unavailable");
+        assert!(ClassifierFailure::Malformed("invalid JSON".into()).retryable());
+    }
+
+    #[test]
+    fn future_family_versions_sort_numerically() {
+        let (_, old) = family_version("gpt-6.2-sol").unwrap();
+        let (family, future) = family_version("gpt-6.10-sol").unwrap();
+        assert_eq!(family, "sol");
+        assert!(future > old);
+        assert_eq!(family_version("gpt-6.3-sol"), Some(("sol", vec![6, 3])));
+        assert_eq!(family_version("new-model-name"), None);
+    }
+
+    #[test]
+    fn effort_tiers_and_strict_decision() {
+        let history = vec![
+            ("a".into(), "implementation".into()),
+            ("b".into(), "implementation".into()),
+        ];
+        assert!(oscillates(&history, "a", "implementation"));
+        assert!(!oscillates(&history, "a", "debugging"));
+        assert!(!oscillates(&history, "a", "verification"));
+        assert!(!oscillates(&[], "a", "analysis"));
+        let supported = [
+            ReasoningEffort::Low,
+            ReasoningEffort::Medium,
+            ReasoningEffort::High,
+            ReasoningEffort::XHigh,
+        ];
+        assert_eq!(
+            nearest_effort(&supported, "Ultra").unwrap(),
+            ReasoningEffort::XHigh
+        );
+        assert_eq!(
+            nearest_effort(&supported, "Standard").unwrap(),
+            ReasoningEffort::Medium
+        );
+        assert!(nearest_effort(&[], "Deep").is_err());
+        assert!(nearest_effort(&supported, "invalid").is_err());
+        let valid = r#"{"model":"gpt-6-luna","tier":"Low","stage":"analysis","reason":"routine"}"#;
+        assert!(parse_decision(valid).is_ok());
+        let with_workflow = r#"{"model":"gpt-6-luna","tier":"Low","stage":"analysis","reason":"routine","skills":["agent-skills:debugging-and-error-recovery"],"knowledge":true,"independent_review":false}"#;
+        let decision = parse_decision(with_workflow).unwrap();
+        assert_eq!(
+            decision.skills,
+            ["agent-skills:debugging-and-error-recovery"]
+        );
+        assert!(decision.knowledge);
+        assert!(parse_decision("").is_err());
+        assert!(parse_decision("not JSON").is_err());
+        assert!(parse_decision(&valid.replace("Low", "invalid")).is_err());
+        assert!(parse_decision(&valid.replace("analysis", "invalid")).is_err());
+        assert!(
+            serde_json::from_str::<Decision>(&valid.replace("\"reason\":", "\"extra\":")).is_err()
+        );
+    }
+}
