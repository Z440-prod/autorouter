+#[derive(Deserialize)]
+struct ModelEvaluations {
+    version: u8,
+    families: BTreeMap<String, EvaluatedFamily>,
+    checks: BTreeMap<String, EvaluationOutcome>,
+}
+
+#[derive(Deserialize)]
+struct EvaluatedFamily {
+    current: Option<String>,
+}
+
+#[derive(Deserialize)]
+struct EvaluationOutcome {
+    passed: bool,
+}
+
+async fn verified_defaults(turn: &TurnContext) -> BTreeMap<String, String> {
+    if turn.config.model_provider_id != "openai" || turn.config.model_catalog.is_some() {
+        return BTreeMap::new();
+    }
+    let path = turn
+        .config
+        .codex_home
+        .join("autorouter/verified-models.json");
+    let Ok(bytes) = tokio::fs::read(path).await else {
+        return BTreeMap::new();
+    };
+    let Ok(state) = serde_json::from_slice::<ModelEvaluations>(&bytes) else {
+        return BTreeMap::new();
+    };
+    if state.version != 1 {
+        return BTreeMap::new();
+    }
+    state
+        .families
+        .into_iter()
+        .filter_map(|(family, preferred)| {
+            let current = preferred.current?;
+            if family_version(&current)?.0 == family
+                && state.checks.get(&current).is_some_and(|check| check.passed)
+            {
+                Some((family, current))
+            } else {
+                None
+            }
+        })
+        .collect()
+}
