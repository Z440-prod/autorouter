+fn workflow_skills(turn: &TurnContext) -> Vec<codex_skills::SkillMetadata> {
+    let snapshot = turn.skills_snapshot();
+    let outcome = snapshot.outcome();
+    outcome
+        .skills
+        .iter()
+        .filter(|skill| {
+            skill
+                .plugin_id
+                .as_deref()
+                .is_some_and(|plugin| ROUTABLE_PLUGINS.contains(&plugin))
+                && skill.allows_implicit_invocation()
+                && outcome.is_skill_enabled(skill)
+                && skill.dependencies.is_none()
+        })
+        .cloned()
+        .collect()
+}
