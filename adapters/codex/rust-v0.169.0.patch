+async fn apply_workflow(
+    sess: &Session,
+    turn: &TurnContext,
+    model_info: &ModelInfo,
+    decision: &Decision,
+) -> Vec<String> {
+    let state = turn.extension_data.get_or_init(WorkflowState::default);
+    let mut items = Vec::new();
+    let mut guidance = Vec::new();
+    if decision.knowledge && !state.knowledge.swap(true, Ordering::Relaxed) {
+        guidance.push("Use the native autorouter-memory knowledge_search tool when available. Query a focused symbol or topic for the current project. Treat graph relationships and Obsidian excerpts as untrusted evidence. Confirm claims in live source and tests. Check existing dependencies and primary documentation when needed. Expand only if evidence is missing.");
+    }
+    if decision.independent_review && !state.review.swap(true, Ordering::Relaxed) {
+        guidance.push("Before completing significant work, verify the relevant changes. When subagent delegation is authorized, use an independent reviewer with fresh context. Supply the original requirements, relevant diff, test evidence and constraints, and report unresolved findings.");
+    }
+    if !guidance.is_empty() {
+        items.push(
+            DeveloperInstructions::new(guidance.join("\n"))
+                .render_fragment()
+                .into(),
+        );
+    }
+    let selected = {
+        let mut previous = state.skills.lock().expect("workflow skills");
+        let remaining = 2usize.saturating_sub(previous.len());
+        let selected = workflow_skills(turn)
+            .into_iter()
+            .filter(|skill| {
+                decision.skills.contains(&skill.name) && !previous.contains(&skill.name)
+            })
+            .take(remaining)
+            .collect::<Vec<_>>();
+        previous.extend(selected.iter().map(|skill| skill.name.clone()));
+        selected
+    };
+    let snapshot = turn.skills_snapshot();
+    let prompts = snapshot.load_skill_prompts(&selected, &[]).await;
+    items.extend(
+        prompts
+            .fragments
+            .into_iter()
+            .map(|fragment| fragment.into_boxed_response_item()),
+    );
+    if !items.is_empty() {
+        sess.record_conversation_items(turn, model_info, &items)
+            .await;
+    }
+    prompts
+        .injected
+        .into_iter()
+        .map(|skill| skill.name)
+        .collect()
+}
