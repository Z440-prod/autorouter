+fn family_version(model: &str) -> Option<(&str, Vec<u32>)> {
+    let (version, family) = model.strip_prefix("gpt-")?.split_once('-')?;
+    if !["luna", "terra", "sol", "astra"].contains(&family) {
+        return None;
+    }
+    let mut version = version
+        .split('.')
+        .map(str::parse)
+        .collect::<Result<Vec<u32>, _>>()
+        .ok()?;
+    while version.last() == Some(&0) {
+        version.pop();
+    }
+    Some((family, version))
+}
+
+fn classifier<'a>(
+    models: &'a [ModelPreset],
+    verified: &BTreeMap<String, String>,
+) -> Option<&'a ModelPreset> {
+    if let Some(model) = verified
+        .get("luna")
+        .and_then(|id| models.iter().find(|model| &model.model == id))
+    {
+        return Some(model);
+    }
+    models
+        .iter()
+        .filter_map(|model| {
+            let (family, version) = family_version(&model.model)?;
+            let rank = match family {
+                "luna" => 4,
+                "sol" => 3,
+                "terra" => 2,
+                "astra" => 1,
+                _ => return None,
+            };
+            effort(model, "Low").ok()?;
+            Some(((rank, version), model))
+        })
+        .max_by(|(a, _), (b, _)| a.cmp(b))
+        .map(|(_, model)| model)
+}
