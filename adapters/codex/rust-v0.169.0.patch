+fn effort(model: &ModelPreset, tier: &str) -> Result<ReasoningEffort, String> {
+    nearest_effort(
+        &model
+            .supported_reasoning_efforts
+            .iter()
+            .map(|e| e.effort.clone())
+            .collect::<Vec<_>>(),
+        tier,
+    )
+}
+
+fn nearest_effort(supported: &[ReasoningEffort], tier: &str) -> Result<ReasoningEffort, String> {
+    let order = ["minimal", "low", "medium", "high", "xhigh", "max"];
+    let requested = match tier {
+        "Low" => 1,
+        "Standard" => 2,
+        "Deep" => 3,
+        "Expert" => 4,
+        "Ultra" => 5,
+        _ => return Err("Invalid reasoning tier".into()),
+    };
+    supported
+        .iter()
+        .filter_map(|entry| {
+            order
+                .iter()
+                .position(|e| *e == entry.as_str())
+                .map(|index| (index.abs_diff(requested), entry.clone()))
+        })
+        .min_by_key(|(distance, _)| *distance)
+        .map(|(_, effort)| effort)
+        .ok_or_else(|| "No supported reasoning effort".into())
+}
