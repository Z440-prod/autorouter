+async fn patch_key(path: &PathUri, environment: &TurnEnvironment) -> (String, PathUri) {
+    if environment.environment().is_remote() {
+        return (environment.selection.environment_id.clone(), path.clone());
+    }
+    // Resolve existing symlinks, including a parent symlink for a new file.
+    let local = path.to_path_buf();
+    let resolved = match tokio::fs::canonicalize(&local).await {
+        Ok(resolved) => Some(resolved),
+        Err(_) => match (local.parent(), local.file_name()) {
+            (Some(parent), Some(name)) => tokio::fs::canonicalize(parent)
+                .await
+                .ok()
+                .map(|parent| parent.join(name)),
+            _ => None,
+        },
+    };
+    (
+        String::new(),
+        resolved
+            .and_then(|path| PathUri::from_host_native_path(path).ok())
+            .unwrap_or_else(|| path.clone()),
+    )
+}
