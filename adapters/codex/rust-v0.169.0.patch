+// The lock spans approval and execution across native agent threads in this process.
+static PATCH_PATHS: std::sync::Mutex<Option<HashSet<(String, PathUri)>>> =
+    std::sync::Mutex::new(None);
+
+struct PatchOwnership(Vec<(String, PathUri)>);
+
+impl PatchOwnership {
+    fn acquire(paths: Vec<(String, PathUri)>) -> Result<Self, FunctionCallError> {
+        let mut state = PATCH_PATHS
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        let owned = state.get_or_insert_with(HashSet::new);
+        if let Some((_, path)) = paths.iter().find(|key| owned.contains(*key)) {
+            return Err(FunctionCallError::RespondToModel(format!(
+                "The path {path} is owned by another active patch. Wait for it to finish and re-read the file."
+            )));
+        }
+        owned.extend(paths.iter().cloned());
+        Ok(Self(paths))
+    }
+}
+
+impl Drop for PatchOwnership {
+    fn drop(&mut self) {
+        let mut state = PATCH_PATHS
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if let Some(owned) = state.as_mut() {
+            for key in &self.0 {
+                owned.remove(key);
+            }
+        }
+    }
+}
