+fn observe_catalog(sess: &Session, models: &[codex_protocol::openai_models::CatalogModel]) {
+    let observed = sess
+        .services
+        .thread_extension_data
+        .get_or_init(CatalogObservations::default);
+    let current = models
+        .iter()
+        .filter(|entry| entry.origin == ModelOrigin::Provider)
+        .map(|entry| (entry.slug.clone(), Arc::clone(&entry.model)))
+        .collect::<BTreeMap<_, _>>();
+    let mut previous = observed.0.lock().expect("catalog observations");
+    for (id, model) in &current {
+        let change = match previous.get(id) {
+            None => "added",
+            Some(old) if old != model => "changed",
+            Some(_) => continue,
+        };
+        tracing::info!(target: "autorouter", model = %id, change, "provider catalog update");
+    }
+    for id in previous.keys().filter(|id| !current.contains_key(*id)) {
+        tracing::info!(target: "autorouter", model = %id, change = "removed", "provider catalog update");
+    }
+    *previous = current;
+}
