+#[tokio::test]
+async fn cold_start_recovers_expired_missing_and_corrupt_primary_catalogs() {
+    for damage in ["expired", "missing", "corrupt"] {
+        let home = tempdir().unwrap();
+        let primary = home.path().join(MODEL_CACHE_FILE);
+        let cache = Arc::new(FileModelsCache::new(
+            primary.clone(),
+            DEFAULT_MODEL_CACHE_TTL,
+        ));
+        let endpoint = TestModelsEndpoint::with_command_auth(vec![
+            Err(CodexErr::RequestTimeout),
+            Err(catalog_http_error(403)),
+            Err(CodexErr::RequestTimeout),
+        ]);
+        let model = remote_model("verified-model", "Verified", 1);
+        let entry = ModelsCacheEntry {
+            fetched_at: Utc::now() - chrono::Duration::hours(1),
+            etag: None,
+            client_version: Some(crate::client_version_to_whole()),
+            identity: endpoint.identity(),
+            models: vec![model.clone()],
+        };
+        cache.store(&entry).await.unwrap();
+        match damage {
+            "missing" => tokio::fs::remove_file(&primary).await.unwrap(),
+            "corrupt" => tokio::fs::write(&primary, b"damaged").await.unwrap(),
+            _ => {}
+        }
+        let manager = OpenAiModelsManager::new_with_cache(cache.clone(), endpoint.clone(), None)
+            .with_provider_catalog();
+        manager
+            .ensure_initialized(DEFAULT_HTTP_CLIENT_FACTORY)
+            .await;
+        assert_eq!(manager.get_remote_models().await, vec![model]);
+        assert_eq!(
+            manager.remote_models.read().await.entry.fetched_at,
+            entry.fetched_at
+        );
+        manager
+            .raw_model_catalog(RefreshStrategy::Online, DEFAULT_HTTP_CLIENT_FACTORY)
+            .await;
+        assert!(manager.get_remote_models().await.is_empty());
+        tokio::fs::remove_file(&primary).await.unwrap();
+        let restarted =
+            OpenAiModelsManager::new_with_cache(cache, endpoint, None).with_provider_catalog();
+        restarted
+            .ensure_initialized(DEFAULT_HTTP_CLIENT_FACTORY)
+            .await;
+        assert!(restarted.get_remote_models().await.is_empty());
+    }
+}
