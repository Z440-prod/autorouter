+//! Private tool journal. An unfinished entry is evidence, never a replay instruction.
+use std::io;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+
+use serde_json::Value;
+
+pub(crate) fn directory(
+    home: &Path,
+    thread: codex_protocol::ThreadId,
+    id: &str,
+) -> Option<PathBuf> {
+    let id = id.strip_prefix("exec-")?;
+    let uuid = uuid::Uuid::parse_str(id).ok()?;
+    Some(
+        home.join("autorouter")
+            .join("tool-artifacts")
+            .join(thread.to_string())
+            .join(uuid.to_string()),
+    )
+}
+
+pub(super) fn begin(path: &Path, record: &Value) -> io::Result<()> {
+    let mut builder = std::fs::DirBuilder::new();
+    builder.recursive(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::DirBuilderExt;
+        builder.mode(0o700);
+    }
+    builder.create(path.parent().ok_or(io::ErrorKind::InvalidInput)?)?;
+    builder.recursive(false);
+    builder.create(path)?;
+    persist(path, "started.json", record)
+}
+
+pub(super) fn persist(path: &Path, name: &str, record: &Value) -> io::Result<()> {
+    let mut file = tempfile::NamedTempFile::new_in(path)?;
+    serde_json::to_writer(file.as_file_mut(), record)?;
+    file.write_all(b"\n")?;
+    file.as_file().sync_all()?;
+    file.persist_noclobber(path.join(name))
+        .map_err(|error| error.error)?;
+    #[cfg(unix)]
+    std::fs::File::open(path)?.sync_all()?;
+    Ok(())
+}
+
+#[cfg(test)]
+#[test]
+fn interrupted_records_survive_without_claiming_completion() {
+    let home = tempfile::tempdir().unwrap();
+    let path = home.path().join("thread/call");
+    begin(&path, &serde_json::json!({"tool": "exec_command"})).unwrap();
+    assert!(path.join("started.json").is_file());
+    assert!(!path.join("result.json").exists());
+    assert!(begin(&path, &serde_json::json!({})).is_err());
+    persist(&path, "result.json", &serde_json::json!({"exit_code": 7})).unwrap();
+    assert_eq!(
+        serde_json::from_slice::<Value>(&std::fs::read(path.join("result.json")).unwrap()).unwrap()
+            ["exit_code"],
+        7
+    );
+}
